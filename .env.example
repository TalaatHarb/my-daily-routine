# Copy to .env (or export) to override local defaults. All values below are the local-development defaults.

# --- API (ASP.NET Core; `__` maps to nested configuration keys) ---
ConnectionStrings__Default=Host=localhost;Port=5432;Database=my_daily_routine;Username=my_daily_routine;Password=my_daily_routine
Jwt__Authority=http://localhost:8081/realms/my-daily-routine
Jwt__Audience=my-daily-routine-web
# Optional: fetch OIDC metadata from a different (e.g. in-cluster) address than the public issuer.
# Jwt__MetadataAddress=http://keycloak:8081/realms/my-daily-routine/.well-known/openid-configuration
Jwt__RequireHttpsMetadata=false
Cors__AllowedOrigins=http://localhost:5173,http://localhost:4173,http://localhost:8090
Database__MigrateOnStartup=true

# --- Web (Vite; copy into apps/web/.env) ---
VITE_API_BASE_URL=http://localhost:8080
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/my-daily-routine
VITE_OIDC_CLIENT_ID=my-daily-routine-web
